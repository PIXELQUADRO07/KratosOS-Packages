name=vim
version=9.1.0
release=1
arch=x86_64
license="Vim"
description="Vi Improved, a highly configurable text editor"
source="https://github.com/vim/vim/archive/refs/tags/v9.1.0.tar.gz"
sha256="ddb435f6e386c53799a3025bdc5a3533beac735a0ee596cb27ada97366a1c725"
depends="glibc,ncurses"

build() {
    export CFLAGS="-std=gnu17"
    export CXXFLAGS="-std=gnu++17"
    ./configure \
        --host="${TARGET}" \
        --prefix=/usr \
        --with-tlib=ncursesw \
        --enable-gui=no \
        --without-x \
        --disable-nls \
        --with-compiledby="KratosOS Builder"

    make -j$(nproc)
}

package() {
    make DESTDIR="${PKGDIR}" install
    ln -sfv vim "${PKGDIR}/usr/bin/vi"
}
