name=xf86-video-vesa
version=2.6.0
release=1
arch=x86_64
license="MIT"
description="X.org VESA video driver (generic fallback)"
source="https://xorg.freedesktop.org/releases/individual/driver/xf86-video-vesa-2.6.0.tar.xz"
sha256="PLACEHOLDER_sha256_xf86-video-vesa_2.6.0"
depends="xorg-server"

build() {
    ./configure \
        --host="${TARGET}" \
        --build=x86_64-pc-linux-gnu \
        --prefix=/usr
    make
}

package() {
    make DESTDIR="${PKGDIR}" install
}
