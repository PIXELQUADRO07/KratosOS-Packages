name=xkeyboard-config
version=2.43
release=1
arch=x86_64
license="MIT"
description="X keyboard layout descriptions"
source="https://xorg.freedesktop.org/releases/individual/data/xkeyboard-config/xkeyboard-config-2.43.tar.xz"
sha256="c810f362c82a834ee89da81e34cd1452c99789339f46f6037f4b9e227dd06c01"
depends="xorgproto"

build() {
    mkdir -p build
    meson setup build \
        --cross-file="${SYSROOT}/../scripts/kratos-cross-file.txt" \
        --prefix=/usr \
        -Dxkb-base=/usr/share/X11/xkb \
        -Dcompat-rules=true
    ninja -C build
}

package() {
    DESTDIR="${PKGDIR}" ninja -C build install
}
