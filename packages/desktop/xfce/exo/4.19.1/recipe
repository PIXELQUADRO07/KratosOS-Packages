name=exo
version=4.19.1
release=1
arch=x86_64
license="GPL-2.0-or-later"
description="Application development library for Xfce"
source="https://archive.xfce.org/src/xfce/exo/4.19/exo-4.19.1.tar.bz2"
sha256="4c3721d47126b1a3143f00a4e4dff5eea364c02c3fa141b09c0b1af16b1f0794"
depends="libxfce4util,libxfce4ui,gtk+3"

build() {
    ./configure \
        --host="${TARGET}" \
        --build=x86_64-pc-linux-gnu \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-static \
        --disable-introspection
    make
}

package() {
    make DESTDIR="${PKGDIR}" install
}
