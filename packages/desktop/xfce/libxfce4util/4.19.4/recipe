name=libxfce4util
version=4.19.4
release=1
arch=x86_64
license="LGPL-2.0-or-later"
description="Basic utility library for Xfce"
source="https://archive.xfce.org/src/xfce/libxfce4util/4.19/libxfce4util-4.19.4.tar.bz2"
sha256="f405ba1cd613d7ecb84c9bec16146af8fe68605aebdb245c0273af651983e1e9"
depends="glib"

build() {
    ./configure \
        --host="${TARGET}" \
        --build=x86_64-pc-linux-gnu \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-static \
        --disable-introspection \
        --disable-vala
    make
}

package() {
    make DESTDIR="${PKGDIR}" install
}
