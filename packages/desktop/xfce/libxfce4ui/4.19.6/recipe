name=libxfce4ui
version=4.19.6
release=1
arch=x86_64
license="LGPL-2.0-or-later"
description="Widget library for Xfce"
source="https://archive.xfce.org/src/xfce/libxfce4ui/4.19/libxfce4ui-4.19.6.tar.bz2"
sha256="effe2c29408161beff4ae879f4591e7209c2bf5517c46545a1701337950afc7c"
depends="libxfce4util,xfconf,gtk+3,libX11,libSM,libICE,startup-notification"

build() {
    ./configure \
        --host="${TARGET}" \
        --build=x86_64-pc-linux-gnu \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-static \
        --disable-introspection \
        --disable-vala \
        --disable-gladeui2 \
        --enable-x11 \
        --disable-wayland
    make
}

package() {
    mkdir -p "${PKGDIR}/usr/lib/pkgconfig"
    make DESTDIR="${PKGDIR}" install
}
