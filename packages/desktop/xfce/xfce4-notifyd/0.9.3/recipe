name=xfce4-notifyd
version=0.9.3
release=1
arch=x86_64
license="GPL-2.0-or-later"
description="Notification daemon for the Xfce desktop"
source="https://archive.xfce.org/src/apps/xfce4-notifyd/0.9/xfce4-notifyd-0.9.3.tar.bz2"
sha256="79ee4701e2f8715a700de2431aa33682933cab18d76938bb18e2820302bbe030"
depends="libxfce4ui,libxfce4util,xfconf,gtk+3,libnotify,libcanberra"

build() {
    ./configure \
        --host="${TARGET}" \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-static
    make
}

package() {
    make DESTDIR="${PKGDIR}" install
}
