name=xfce4-session
version=4.19.3
release=1
arch=x86_64
license="GPL-2.0-or-later"
description="Session manager for the Xfce desktop environment"
source="https://archive.xfce.org/src/xfce/xfce4-session/4.19/xfce4-session-4.19.3.tar.bz2"
sha256="06d267e6b633aacd7ef0e1b5865ac5b42a7713267317c0d1cadf66f0bfdce3a9"
depends="libxfce4util,libxfce4ui,xfconf,libSM,libICE,libwnck3,libxfce4windowing,iceauth"

build() {
    export ac_cv_path_ICEAUTH=/usr/bin/iceauth
    ./configure \
        --host="${TARGET}" \
        --build=x86_64-pc-linux-gnu \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-static \
        --disable-systemd \
        --enable-x11 \
        --disable-wayland
    make
}

package() {
    make DESTDIR="${PKGDIR}" install
}
