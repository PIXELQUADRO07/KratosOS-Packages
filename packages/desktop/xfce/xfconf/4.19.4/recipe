name=xfconf
version=4.19.4
release=1
arch=x86_64
license="GPL-2.0-or-later"
description="Configuration storage system for Xfce"
source="https://archive.xfce.org/src/xfce/xfconf/4.19/xfconf-4.19.4.tar.bz2"
sha256="9c1d70be5a86141944d8a69fcc836dee0bd47e60ec9b0d2bca2bb2c4725618ec"
depends="libxfce4util,dbus,glib"

build() {
    ./configure \
        --host="${TARGET}" \
        --build=x86_64-pc-linux-gnu \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-static \
        --disable-introspection \
        --disable-vala
    make
}

package() {
    mkdir -p "${PKGDIR}/usr/lib/pkgconfig"
    make DESTDIR="${PKGDIR}" install
}
