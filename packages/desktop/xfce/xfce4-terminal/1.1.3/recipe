name=xfce4-terminal
version=1.1.3
release=1
arch=x86_64
license="GPL-2.0-or-later"
description="Terminal emulator for Xfce"
source="https://archive.xfce.org/src/apps/xfce4-terminal/1.1/xfce4-terminal-1.1.3.tar.bz2"
sha256="214dd588d441b69f816009682a3bb4652cc19bed7ea64b612a12f097417b3d45"
depends="libxfce4util,libxfce4ui,xfconf,vte3,gtk+3"

build() {
    ./configure \
        --host="${TARGET}" \
        --build=x86_64-pc-linux-gnu \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-static
    make
}

package() {
    make DESTDIR="${PKGDIR}" install
}
