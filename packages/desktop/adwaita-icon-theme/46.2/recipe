name=adwaita-icon-theme
version=46.2
release=1
arch=x86_64
license="LGPL-3.0-or-later OR CC-BY-SA-3.0"
description="Adwaita icon theme"
source="https://download.gnome.org/sources/adwaita-icon-theme/46/adwaita-icon-theme-46.2.tar.xz"
sha256="beb126b9429339ba762e0818d5e73b2c46f444975bf80076366eae2d0f96b5cb"
depends="hicolor-icon-theme"

build() {
    mkdir -p build
    meson setup build \
        --cross-file="${SYSROOT}/../scripts/kratos-cross-file.txt" \
        --prefix=/usr
    ninja -C build
}

package() {
    DESTDIR="${PKGDIR}" ninja -C build install
}
