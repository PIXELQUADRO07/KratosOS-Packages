name=libwnck3
version=43.0
release=1
arch=x86_64
license="LGPL-2.0-or-later"
description="Window Navigator Construction Kit"
source="https://download.gnome.org/sources/libwnck/43/libwnck-43.0.tar.xz"
sha256="PLACEHOLDER_sha256_libwnck3_43.0"
depends="gtk+3,libX11,libXres,startup-notification"

build() {
    mkdir -p build
    meson setup build \
        --cross-file="${SYSROOT}/../scripts/kratos-cross-file.txt" \
        --prefix=/usr \
        --libdir=lib \
        -Dintrospection=disabled \
        -Dgtk_doc=false
    ninja -C build
}

package() {
    DESTDIR="${PKGDIR}" ninja -C build install
}
