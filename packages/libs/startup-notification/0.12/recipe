name=startup-notification
version=0.12
release=1
arch=x86_64
license="LGPL-2.0-or-later"
description="X11 application startup notification library"
source="https://www.freedesktop.org/software/startup-notification/releases/startup-notification-0.12.tar.gz"
sha256="PLACEHOLDER_sha256_startup-notification_0.12"
depends="libX11,libxcb,xcb-util"

build() {
    ./configure \
        --host="${TARGET}" \
        --build=x86_64-pc-linux-gnu \
        --prefix=/usr \
        --disable-static
    make
}

package() {
    make DESTDIR="${PKGDIR}" install
}
