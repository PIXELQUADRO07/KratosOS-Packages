name=harfbuzz
version=2.7.4
release=1
arch=x86_64
license="MIT"
description="Text shaping library"
source="https://github.com/harfbuzz/harfbuzz/releases/download/2.7.4/harfbuzz-2.7.4.tar.xz"
sha256="6ad11d653347bd25d8317589df4e431a2de372c0cf9be3543368e07ec23bb8e7"
depends="glibc,freetype,glib"

build() {
    ./configure \
        --host="${TARGET}" \
        --prefix=/usr \
        --disable-static \
        --with-freetype=yes \
        --with-glib=yes \
        --with-gobject=yes
    make
}

package() {
    make DESTDIR="${PKGDIR}" install
}
