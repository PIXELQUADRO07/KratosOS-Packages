name=polkit
version=124
release=1
arch=x86_64
license="LGPL-2.0-or-later"
description="Policy authorization framework"
source="https://github.com/polkit-org/polkit/archive/refs/tags/124.tar.gz"
sha256="72457d96a0538fd03a3ca96a6bf9b7faf82184d4d67c793eb759168e4fd49e20"
depends="glib,dbus,libxcrypt,expat"

build() {
    mkdir -p build
    meson setup build \
        --cross-file="${SYSROOT}/../scripts/kratos-cross-file.txt" \
        --prefix=/usr \
        --libdir=lib \
        --sysconfdir=/etc \
        --localstatedir=/var \
        -Dauthfw=shadow \
        -Dsession_tracking=ConsoleKit \
        -Dintrospection=false \
        -Dman=false \
        -Dtests=false
    ninja -C build
}

package() {
    DESTDIR="${PKGDIR}" ninja -C build install
}
