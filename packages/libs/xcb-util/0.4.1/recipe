name=xcb-util
version=0.4.1
release=1
arch=x86_64
license="MIT"
description="XCB utility libraries"
source="https://xcb.freedesktop.org/dist/xcb-util-0.4.1.tar.xz"
sha256="5abe3bbbd8e54f0fa3ec945291b7e8fa8cfd3cccc43718f8758430f94126e512"
depends="libxcb"

build() {
    ./configure \
        --host="${TARGET}" \
        --build=x86_64-pc-linux-gnu \
        --prefix=/usr \
        --disable-static
    make
}

package() {
    make DESTDIR="${PKGDIR}" install
}
