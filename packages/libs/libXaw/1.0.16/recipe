name=libXaw
version=1.0.16
release=1
arch=x86_64
license="MIT"
description="X.Org Athena Widgets library"
source="https://xorg.freedesktop.org/releases/individual/lib/libXaw-1.0.16.tar.xz"
sha256="731d572b54c708f81e197a6afa8016918e2e06dfd3025e066ca642a5b8c39c8f"
depends="libX11,libXext,libXt,libXmu,libXpm,xorgproto"

build() {
    ./configure \
        --host="${TARGET}" \
        --build=x86_64-pc-linux-gnu \
        --prefix=/usr \
        --disable-static
    make
}

package() {
    make DESTDIR="${PKGDIR}" install
}
