name=gtk+3
version=3.24.30
release=1
arch=x86_64
license="LGPL-2.1-or-later"
description="Multi-platform toolkit for creating graphical user interfaces"
source="https://download.gnome.org/sources/gtk+/3.24/gtk+-3.24.30.tar.xz"
sha256="ba75bfff320ad1f4cfbee92ba813ec336322cc3c660d406aad014b07087a3ba9"
depends="glibc,glib,atk,gdk-pixbuf,pango,cairo,libX11,libXext,libXcursor,libXfixes,libXi,libXrandr,libXcomposite,libXdamage"

build() {
    sed -i 's/gtk_widget_queue_resize (label)/gtk_widget_queue_resize (GTK_WIDGET (label))/g' gtk/gtklabel.c
    sed -i 's/_gtk_get_slowdown (gdouble factor)/_gtk_get_slowdown (void)/g' gtk/gtkprogresstracker.c
    ./configure \
        --host="${TARGET}" \
        --build=x86_64-pc-linux-gnu \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --enable-x11-backend \
        --disable-wayland-backend \
        --disable-introspection \
        --disable-papi \
        --disable-cloudprint
    make
}

package() {
    make DESTDIR="${PKGDIR}" install
}
