name=libxshmfence
version=1.3.2
release=1
arch=x86_64
license="MIT"
description="Shared memory SyncFence synchronization library"
source="https://xorg.freedesktop.org/releases/individual/lib/libxshmfence-1.3.2.tar.xz"
sha256="870df257bc40b126d91b5a8f1da6ca8a524555268c50b59c0acd1a27f361606f"
depends="xorgproto"

build() {
    ./configure \
        --host="${TARGET}" \
        --build=x86_64-pc-linux-gnu \
        --prefix=/usr \
        --disable-static
    make
}

package() {
    make DESTDIR="${PKGDIR}" install
}
