name=cairo
version=1.16.0
release=1
arch=x86_64
license="LGPL-2.1-or-later"
description="2D graphics library with support for multiple output devices"
source="https://cairographics.org/releases/cairo-1.16.0.tar.xz"
sha256="5e7b29b3f113ef870d1e3ecf8adf21f923396401604bda16d44be45e66052331"
depends="glibc,pixman,freetype,fontconfig,libpng,libX11,libXext,libXrender"

build() {
    ./configure \
        --host="${TARGET}" \
        --prefix=/usr \
        --disable-static \
        --enable-xlib=yes \
        --enable-xlib-xrender=yes \
        --enable-xcb=yes \
        --enable-gl=no \
        --enable-glesv2=no
    make -C src
    make -C util
}

package() {
    make -C src DESTDIR="${PKGDIR}" install
    make -C util DESTDIR="${PKGDIR}" install
}
