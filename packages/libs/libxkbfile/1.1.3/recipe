name=libxkbfile
version=1.1.3
release=1
arch=x86_64
license="MIT"
description="X.Org xkbfile library"
source="https://xorg.freedesktop.org/releases/individual/lib/libxkbfile-1.1.3.tar.xz"
sha256="a9b63eea997abb9ee6a8b4fbb515831c841f471af845a09de443b28003874bec"
depends="libX11,xorgproto"

build() {
    ./configure \
        --host="${TARGET}" \
        --build=x86_64-pc-linux-gnu \
        --prefix=/usr \
        --disable-static
    make
}

package() {
    make DESTDIR="${PKGDIR}" install
}
