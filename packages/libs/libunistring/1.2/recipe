name=libunistring
version=1.2
release=1
arch=x86_64
license="LGPL-3.0-or-later"
description="Library for manipulating Unicode strings"
source="https://ftp.gnu.org/gnu/libunistring/libunistring-1.2.tar.xz"
sha256="632bd65ed74a881ca8a0309a1001c428bd1cbd5cd7ddbf8cedcd2e65f4dcdc44"
depends="glibc"

build() {
    ./configure \
        --host="${TARGET}" \
        --prefix=/usr \
        --disable-static
    make -j$(nproc)
}

package() {
    make DESTDIR="${PKGDIR}" install
}
