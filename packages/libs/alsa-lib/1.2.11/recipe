name=alsa-lib
version=1.2.11
release=1
arch=x86_64
license="LGPL-2.1-only"
description="Advanced Linux Sound Architecture (ALSA) library"
source="https://www.alsa-project.org/files/pub/lib/alsa-lib-1.2.11.tar.bz2"
sha256="9f3f2f69b995f9ad37359072fbc69a3a88bfba081fc83e9be30e14662795bb4d"
depends=""

build() {
    ./configure \
        --host="${TARGET}" \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-static \
        --disable-python
    make
}

package() {
    make DESTDIR="${PKGDIR}" install
}
