name=gdk-pixbuf
version=2.42.12
release=2
arch=x86_64
license="LGPL-2.0-or-later"
description="Image loading library"
source="https://download.gnome.org/sources/gdk-pixbuf/2.42/gdk-pixbuf-2.42.12.tar.xz"
sha256="b9505b3445b9a7e48ced34760c3bcb73e966df3ac94c95a148cb669ab748e3c7"
depends="glib,libpng,libjpeg-turbo,tiff"

build() {
    mkdir -p build
    meson setup build \
        --cross-file="${SYSROOT}/../scripts/kratos-cross-file.txt" \
        --prefix=/usr \
        --libdir=lib \
        -Dintrospection=disabled \
        -Dman=false \
        -Dgtk_doc=false \
        -Dinstalled_tests=false \
        -Dpng=enabled \
        -Djpeg=enabled \
        -Dtiff=enabled \
        -Dgif=enabled \
        -Dbuiltin_loaders=none \
        -Drelocatable=false
    ninja -C build
}

package() {
    DESTDIR="${PKGDIR}" ninja -C build install
    test -f "${PKGDIR}/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders/libpixbufloader-png.so"

    # Generate loaders.cache with absolute paths
    # We use the cross-built query-loaders tool, which works on the host if it's the same arch
    echo "[+] Generating loaders.cache..."
    LD_LIBRARY_PATH="${SYSROOT}/usr/lib:${PKGDIR}/usr/lib" \
    "${PKGDIR}/usr/bin/gdk-pixbuf-query-loaders" \
    "${PKGDIR}/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders"/*.so \
    > "${PKGDIR}/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache"

    # Remove the staging prefix to make paths absolute for the target
    sed -i "s|${PKGDIR}||g" "${PKGDIR}/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache"

    echo "[✓] loaders.cache generated successfully."
}
