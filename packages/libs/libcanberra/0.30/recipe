name=libcanberra
version=0.30
release=1
arch=x86_64
license="LGPL-2.1-only"
description="Implementation of the XDG Sound Theme and Name Specifications"
source="http://0pointer.de/lennart/projects/libcanberra/libcanberra-0.30.tar.xz"
sha256="c2b671e67e0c288a69fc33dc1b6f1b534d07882c2aceed37004bf48c601afa72"
depends="glib,libsndfile,alsa-lib"

build() {
    ./configure \
        --host="${TARGET}" \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-static \
        --disable-oss \
        --disable-gtk \
        --disable-gtk3
    make
}

package() {
    make DESTDIR="${PKGDIR}" install
}
