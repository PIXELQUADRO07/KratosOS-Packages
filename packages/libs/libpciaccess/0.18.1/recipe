name=libpciaccess
version=0.18.1
release=1
arch=x86_64
license="MIT"
description="Generic PCI access library"
source="https://xorg.freedesktop.org/releases/individual/lib/libpciaccess-0.18.1.tar.xz"
sha256="4af43444b38adb5545d0ed1c2ce46d9608cc47b31c2387fc5181656765a6fa76"
depends="zlib"

build() {
    mkdir -p build
    meson setup build \
        --cross-file="${SYSROOT}/../scripts/kratos-cross-file.txt" \
        --prefix=/usr \
        --libdir=lib
    ninja -C build
}

package() {
    DESTDIR="${PKGDIR}" ninja -C build install
}
