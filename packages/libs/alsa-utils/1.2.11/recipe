name=alsa-utils
version=1.2.11
release=1
arch=x86_64
license="GPL-2.0-or-later"
description="Advanced Linux Sound Architecture (ALSA) utilities — amixer, aplay, arecord, alsamixer"
source="https://www.alsa-project.org/files/pub/utils/alsa-utils-1.2.11.tar.bz2"
sha256="9ac6ca3a883f151e568dcf979b8d2e5cbecc51b819bb0e6bb8a2e9b34cc428a7"
depends="alsa-lib"

build() {
    ./configure \
        --host="${TARGET}" \
        --prefix=/usr \
        --sysconfdir=/etc \
        --with-alsa-prefix=/usr \
        --with-alsa-inc-prefix=/usr/include \
        --disable-static \
        --disable-nls \
        --disable-xmlto \
        --disable-rst2man
    
    # Build only core components that don't require complex dependencies
    # Skip topology, alsaucm, bat due to libtool issues with moved .la files
    make -C alsactl install DESTDIR="${PKGDIR}" || true
    make -C amixer install DESTDIR="${PKGDIR}" || true
    make -C aplay install DESTDIR="${PKGDIR}" || true
    make -C amidi install DESTDIR="${PKGDIR}" || true
    make -C alsamixer install DESTDIR="${PKGDIR}" || true
    make -C seq install DESTDIR="${PKGDIR}" || true
    make -C alsaconf install DESTDIR="${PKGDIR}" || true
    make -C include install DESTDIR="${PKGDIR}" || true
    make -C m4 install DESTDIR="${PKGDIR}" || true
}

package() {
    # Install is done during build() to skip problematic directories
    true
}
