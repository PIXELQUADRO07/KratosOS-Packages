name=ncurses
version=6.5
release=1
arch=x86_64
license="MIT"
description="Library for text-based user interfaces"
source="https://ftp.gnu.org/gnu/ncurses/ncurses-6.5.tar.gz"
sha256="136d91bc269a9a5785e5f9e980bc76ab57428f604ce3e5a5a90cebc767971cc6"
depends="glibc"

build() {
    ./configure \
        --host="${TARGET}" \
        --prefix=/usr \
        --with-shared \
        --without-debug \
        --without-ada \
        --enable-widec \
        --without-manpages \
        --without-tests \
        --without-cxx-binding
    make -j$(nproc)
}

package() {
    make DESTDIR="${PKGDIR}" install
    # Compatibility symlinks
    for lib in ncurses form panel menu; do
        ln -sfv "lib${lib}w.so" "${PKGDIR}/usr/lib/lib${lib}.so"
        ln -sfv "lib${lib}w.a"  "${PKGDIR}/usr/lib/lib${lib}.a"
    done
    ln -sfv libncursesw.so "${PKGDIR}/usr/lib/libcurses.so"
}
