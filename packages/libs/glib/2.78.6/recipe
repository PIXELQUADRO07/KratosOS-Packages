name=glib
version=2.78.6
release=1
arch=x86_64
license="LGPL-2.1-or-later"
description="Low-level core library that forms the basis for projects such as GTK+ and GNOME"
source="https://download.gnome.org/sources/glib/2.78/glib-2.78.6.tar.xz"
sha256="244854654dd82c7ebcb2f8e246156d2a05eb9cd1ad07ed7a779659b4602c9fae"
depends="glibc,zlib,pcre2,libffi,util-linux,libmount"

build() {
    mkdir -p build
    meson setup build \
        --cross-file="${SYSROOT}/../scripts/kratos-cross-file.txt" \
        --prefix=/usr \
        --libdir=lib \
        -Dselinux=disabled \
        -Dxattr=false \
        -Dtests=false \
        -Dinstalled_tests=false
    ninja -C build
}

package() {
    DESTDIR="${PKGDIR}" ninja -C build install
}
