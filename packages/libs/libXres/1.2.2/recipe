name=libXres
version=1.2.2
release=1
arch=x86_64
license="MIT"
description="X11 Resource extension library"
source="https://xorg.freedesktop.org/releases/individual/lib/libXres-1.2.2.tar.xz"
sha256="9a7446f3484b9b7538ac5ee30d2c1ce9e5b7fbbaf1440e02f6cca186a1fa745f"
depends="libX11,libXext,xorgproto"

build() {
    ./configure \
        --host="${TARGET}" \
        --build=x86_64-pc-linux-gnu \
        --prefix=/usr \
        --disable-malloc0returnsnull \
        --disable-static
    make
}

package() {
    make DESTDIR="${PKGDIR}" install
}
