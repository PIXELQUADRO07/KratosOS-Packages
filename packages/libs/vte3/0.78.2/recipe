name=vte3
version=0.78.2
release=1
arch=x86_64
license="LGPL-3.0-or-later"
description="Virtual Terminal Emulator widget for GTK"
source="https://download.gnome.org/sources/vte/0.78/vte-0.78.2.tar.xz"
sha256="PLACEHOLDER_sha256_vte3_0.78.2"
depends="gtk+3,pcre2,fribidi,gnutls"

build() {
    mkdir -p build
    meson setup build \
        --cross-file="${SYSROOT}/../scripts/kratos-cross-file.txt" \
        --prefix=/usr \
        --libdir=lib \
        -Dgir=false \
        -Dvapi=false \
        -Dgtk3=true \
        -Dgtk4=false \
        -Ddocs=false
    ninja -C build
}

package() {
    DESTDIR="${PKGDIR}" ninja -C build install
}
