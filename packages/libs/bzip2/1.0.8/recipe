name=bzip2
version=1.0.8
release=1
arch=x86_64
license="BSD-style"
description="High-quality data compressor"
source="https://sourceware.org/pub/bzip2/bzip2-1.0.8.tar.gz"
sha256="ab5a03176ee106d3f0fa90e381da478ddae405918153cca248e682cd0c4a2269"
depends=""

build() {
    # bzip2 doesn't use autoconf, we override vars
    make CC="${CC}" AR="${AR}" RANLIB="${RANLIB}" CFLAGS="${CFLAGS} -fPIC"
}

package() {
    make PREFIX=/usr DESTDIR="${PKGDIR}" install
}
