name=libpcap
version=1.10.4
release=1
arch=x86_64
license="BSD-3-Clause"
description="System-independent interface for user-level packet capture"
source="https://www.tcpdump.org/release/libpcap-1.10.4.tar.gz"
sha256="ed19a0383fad72e3ad435fd239d7cd80d64916b87269550159d20e47160ebe5f"
depends="glibc"

build() {
    ./configure \
        --host="${TARGET}" \
        --prefix=/usr \
        --with-pcap=linux

    make
}

package() {
    make DESTDIR="${PKGDIR}" install
}
