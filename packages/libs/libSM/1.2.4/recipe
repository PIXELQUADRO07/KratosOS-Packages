name=libSM
version=1.2.4
release=1
arch=x86_64
license="MIT"
description="Session Management library (X11)"
source="https://xorg.freedesktop.org/releases/individual/lib/libSM-1.2.4.tar.xz"
sha256="fdcbe51e4d1276b1183da77a8a4e74a137ca203e0bcfb20972dd5f3347e97b84"
depends="libICE,xorgproto"

build() {
    ./configure \
        --host="${TARGET}" \
        --build=x86_64-pc-linux-gnu \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-static \
        --without-libuuid
    make
}

package() {
    make DESTDIR="${PKGDIR}" install
}
