name=libevdev
version=1.13.3
release=1
arch=x86_64
license="MIT"
description="Wrapper library for Linux evdev input interface"
source="https://www.freedesktop.org/software/libevdev/libevdev-1.13.3.tar.xz"
sha256="abf1aace86208eebdd5d3550ffded4c8d73bb405b796d51c389c9d0604cbcfbf"
depends=""

build() {
    mkdir -p build
    meson setup build \
        --cross-file="${SYSROOT}/../scripts/kratos-cross-file.txt" \
        --prefix=/usr \
        --libdir=lib \
        -Dtests=disabled \
        -Ddocumentation=disabled
    ninja -C build
}

package() {
    DESTDIR="${PKGDIR}" ninja -C build install
}
