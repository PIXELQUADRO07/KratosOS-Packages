name=libXt
version=1.3.1
release=1
arch=x86_64
license="MIT"
description="X Toolkit Intrinsics library"
source="https://xorg.freedesktop.org/releases/individual/lib/libXt-1.3.1.tar.xz"
sha256="PLACEHOLDER_sha256_libXt_1.3.1"
depends="libSM,libICE,libX11,xorgproto"

build() {
    ./configure \
        --host="${TARGET}" \
        --build=x86_64-pc-linux-gnu \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-static
    make
}

package() {
    make DESTDIR="${PKGDIR}" install
}
