name=dbus
version=1.16.2
release=1
arch=x86_64
license="GPL-2.0-or-later"
description="D-Bus message bus system"
source="https://dbus.freedesktop.org/releases/dbus/dbus-1.16.2.tar.xz"
sha256="0ba2a1a4b16afe7bceb2c07e9ce99a8c2c3508e5dec290dbb643384bd6beb7e2"
depends="expat,libxcrypt"

build() {
    mkdir -p build
    meson setup build \
        --cross-file="${SYSROOT}/../scripts/kratos-cross-file.txt" \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        -Druntime_dir=/run \
        -Dsystem_socket=/run/dbus/system_bus_socket \
        -Dsystem_pid_file=/run/dbus/pid \
        -Dxml_docs=disabled \
        -Ddoxygen_docs=disabled \
        -Dmodular_tests=disabled \
        -Dinstalled_tests=false
    ninja -C build
}

package() {
    DESTDIR="${PKGDIR}" ninja -C build install
    install -dm755 "${PKGDIR}/run/dbus"
}
