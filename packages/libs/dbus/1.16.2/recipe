name=dbus
version=1.16.2
release=1
arch=x86_64
license="GPL-2.0-or-later"
description="D-Bus message bus system"
source="https://dbus.freedesktop.org/releases/dbus/dbus-1.16.2.tar.xz"
sha256="PLACEHOLDER_sha256_dbus_1.16.2"
depends="expat,libxcrypt"

build() {
    ./configure \
        --host="${TARGET}" \
        --build=x86_64-pc-linux-gnu \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --runstatedir=/run \
        --disable-static \
        --disable-doxygen-docs \
        --disable-xml-docs \
        --disable-tests \
        --with-console-auth-dir=/run/console \
        --with-system-pid-file=/run/dbus/pid \
        --with-system-socket=/run/dbus/system_bus_socket
    make
}

package() {
    make DESTDIR="${PKGDIR}" install
    # Create system socket directory
    install -dm755 "${PKGDIR}/run/dbus"
}
