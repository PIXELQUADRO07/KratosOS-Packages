name=libXmu
version=1.2.1
release=1
arch=x86_64
license="MIT"
description="X Miscellaneous Utility library"
source="https://xorg.freedesktop.org/releases/individual/lib/libXmu-1.2.1.tar.xz"
sha256="fcb27793248a39e5fcc5b9c4aec40cc0734b3ca76aac3d7d1c264e7f7e14e8b2"
depends="libXt,libXext,libX11,xorgproto"

build() {
    ./configure \
        --host="${TARGET}" \
        --build=x86_64-pc-linux-gnu \
        --prefix=/usr \
        --disable-static
    make
}

package() {
    make DESTDIR="${PKGDIR}" install
}
