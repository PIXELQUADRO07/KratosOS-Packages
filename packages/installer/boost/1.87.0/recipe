name=boost
version=1.87.0
release=1
arch=x86_64
license="BSL-1.0"
description="Free peer-reviewed portable C++ source libraries"
source="https://archives.boost.io/release/1.87.0/source/boost_1_87_0.tar.bz2"
sha256="PLACEHOLDER_sha256_boost_1.87.0"
depends="zlib,bzip2,zstd"

build() {
    ./bootstrap.sh --prefix=/usr
    ./b2 -j$(nproc) \
        --target="${TARGET}" \
        --with-system \
        --with-filesystem \
        --with-program_options \
        --with-date_time \
        --with-thread \
        link=shared \
        runtime-link=shared \
        variant=release \
        stage
}

package() {
    ./b2 --prefix="${PKGDIR}/usr" install
}
