name=iproute2
version=7.1.0
release=1
arch=x86_64
license="GPL-2.0"
description="Networking and traffic control tools"
source="https://www.kernel.org/pub/linux/utils/net/iproute2/iproute2-7.1.0.tar.xz"
sha256="fd9fa1b95809417157ca83dd72957e3261bdbce896353cb936f80af0b33a4b5c"
depends="glibc"

build() {
    # iproute2 needs to know where the kernel headers are
    # and it doesn't use a standard autoconf script
    ./configure

    make -j$(nproc) \
        CC="${CC}" \
        AR="${AR}" \
        PREFIX=/usr \
        SBINDIR=/sbin \
        CONFDIR=/etc/iproute2 \
        DATADIR=/usr/share/iproute2
}

package() {
    make DESTDIR="${PKGDIR}" \
        PREFIX=/usr \
        SBINDIR=/sbin \
        install
}
