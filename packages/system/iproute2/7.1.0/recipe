name=iproute2
version=7.1.0
release=1
arch=x86_64
license="GPL-2.0"
description="Networking and traffic control tools"
source="https://www.kernel.org/pub/linux/utils/net/iproute2/iproute2-7.1.0.tar.xz"
sha256="fd9fa1b95809417157ca83dd72957e3261bdbce896353cb936f80af0b33a4b5c"
depends="glibc,libmnl"

build() {
    export CFLAGS="-std=gnu17"
    export CXXFLAGS="-std=gnu++17"
    ./configure

    make -j$(nproc) \
        CC="${TARGET}-gcc" \
        AR="${TARGET}-ar" \
        PREFIX=/usr \
        SBINDIR=/sbin \
        CONFDIR=/etc/iproute2 \
        DATADIR=/usr/share/iproute2 \
        EXTRA_CCOPTS="-I${SYSROOT}/usr/include" \
        EXTRA_LDFLAGS="-L${SYSROOT}/usr/lib"
}

package() {
    make DESTDIR="${PKGDIR}" \
        PREFIX=/usr \
        SBINDIR=/sbin \
        install
}
