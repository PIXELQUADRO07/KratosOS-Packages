name=upower
version=1.90.2
release=1
arch=x86_64
license="GPL-2.0-or-later"
description="Abstraction for enumerating power devices"
source="https://gitlab.freedesktop.org/upower/upower/-/archive/v1.90.2/upower-v1.90.2.tar.gz"
sha256="5c4e736648f0c89d2368fbbe1e6fc0598a1565c4b435bade1d65e890259fb759"
depends="glib,dbus,libusb,libgudev"

build() {
    mkdir -p build
    meson setup build \
        --cross-file="${SYSROOT}/../scripts/kratos-cross-file.txt" \
        --prefix=/usr \
        --libdir=lib \
        --sysconfdir=/etc \
        --localstatedir=/var \
        -Dintrospection=disabled \
        -Dman=false \
        -Dgtk-doc=false \
        -Dsystemdsystemunitdir=no
    ninja -C build
}

package() {
    DESTDIR="${PKGDIR}" ninja -C build install
}
