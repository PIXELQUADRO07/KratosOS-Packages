name=wpa_supplicant
version=2.12
release=1
arch=x86_64
license="BSD-3-Clause"
description="Client for WPA/WPA2/WPA3 and IEEE 802.1X wireless authentication"
source="https://w1.fi/releases/wpa_supplicant-2.12.tar.gz"
sha256="08e23937e16d0155e55cab2b51f51fbe10d80a1aa91c4e15442645059b737ef6"
depends="openssl,libnl,dbus"

build() {
    cd wpa_supplicant

    cat > .config <<'EOF'
CONFIG_BACKEND=file
CONFIG_CTRL_IFACE=y
CONFIG_DRIVER_NL80211=y
CONFIG_DRIVER_WIRED=y
CONFIG_LIBNL32=y
CONFIG_IEEE8021X_EAPOL=y
CONFIG_PKCS12=y
CONFIG_SMARTCARD=y
CONFIG_EAP_TLS=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_MD5=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_GTC=y
CONFIG_EAP_OTP=y
CONFIG_EAP_LEAP=y
CONFIG_PKCS12=y
CONFIG_WPS=y
CONFIG_SAE=y
CONFIG_OWE=y
EOF

    make CC="${CC}" LIBDIR=/usr/lib BINDIR=/usr/sbin
}

package() {
    install -Dm755 wpa_supplicant "${PKGDIR}/usr/sbin/wpa_supplicant"
    install -Dm755 wpa_cli "${PKGDIR}/usr/sbin/wpa_cli"
    install -Dm755 wpa_passphrase "${PKGDIR}/usr/bin/wpa_passphrase"
    install -dm755 "${PKGDIR}/etc/wpa_supplicant"
    install -m600 wpa_supplicant.conf "${PKGDIR}/etc/wpa_supplicant/wpa_supplicant.conf.example"
}
