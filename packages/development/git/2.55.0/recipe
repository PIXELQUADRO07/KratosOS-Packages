name=git
version=2.55.0
release=1
arch=x86_64
license="GPL-2.0-only"
description="Distributed version control system (minimal build: no curl/perl/tcltk)"
source="https://www.kernel.org/pub/software/scm/git/git-2.55.0.tar.gz"
sha256="0842dc384a23ac33ba3e570c4f3a8ded85963ee4713b1cd21153c3db41813d1e"
depends="zlib,openssl,expat"

build() {
    make configure

    # Cross-compiling: configure cannot *run* test programs built for the
    # target, only compile them. These ac_cv_* answers are the correct
    # values for a modern glibc target (same behavior as the build host).
    export ac_cv_iconv_omits_bom=no
    export ac_cv_fread_reads_directories=no
    export ac_cv_snprintf_returns_bogus=no
    export ac_cv_c_c99_format=yes

    ./configure \
        --host="${TARGET}" \
        --build=x86_64-pc-linux-gnu \
        --prefix=/usr
    make CC="${CC}" \
        NO_GETTEXT=1 \
        NO_TCLTK=1 \
        NO_PERL=1 \
        NO_PYTHON=1 \
        NO_CURL=1
}

package() {
    make DESTDIR="${PKGDIR}" prefix=/usr \
        NO_GETTEXT=1 \
        NO_TCLTK=1 \
        NO_PERL=1 \
        NO_PYTHON=1 \
        NO_CURL=1 \
        install
}
